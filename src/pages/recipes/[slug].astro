---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Photo from '../../components/Photo.astro';
import { SITE, COLLECTIONS, CATEGORIES, loadRecipes, fmtMacros, seriesId } from '../../data/site';
import { photoFor } from '../../data/images';
import reelMeta from '../../../content/raw/reel-meta.json';

export async function getStaticPaths() {
  const all = await loadRecipes();
  return all.map((r) => ({ params: { slug: r.slug }, props: { r, all } }));
}
const { r, all } = Astro.props;

const macros = fmtMacros(r);
const inCollections = COLLECTIONS.filter((c) => c.id !== 'popular' && c.filter(r));
const inCategories = CATEGORIES.filter((c) => c.filter(r));
const sid = seriesId(r.series);
const reelId = (r.source_url.match(/\/(?:reel|p|reels)\/([A-Za-z0-9_-]+)/) ?? [])[1];
const reel = (reelMeta as Record<string, { dur?: number | null; views?: number | null }>)[r.slug];

// Related: same series first, then shared tags, then most liked — never itself.
const score = (o: typeof r) => (o.series && o.series === r.series ? 10 : 0) + o.tags.filter((x) => r.tags.includes(x)).length;
const related = all.filter((o) => o.slug !== r.slug).sort((a, b) => score(b) - score(a) || b.likes - a.likes).slice(0, 4);

/* ---------- SEO text ---------- */
const bits = [r.time_minutes ? `${r.time_minutes} min` : null, r.macros.kcal ? `${r.macros.kcal} kcal` : null].filter(Boolean);
const hasRecipeWord = /\brecipe\b/i.test(r.title);
let seoTitle = hasRecipeWord ? r.title : `${r.title} Recipe`;
if (bits.length && (seoTitle + ` (${bits.join(', ')})`).length <= 60) seoTitle += ` (${bits.join(', ')})`;

const nIng = r.ingredients.reduce((n, g) => n + g.items.length, 0);
const facts = [
  r.time_minutes ? `ready in ${r.time_minutes} minutes` : null,
  r.macros.kcal ? `${r.macros.kcal} kcal` : null,
  r.macros.protein ? `${r.macros.protein}g protein per serving` : null,
].filter(Boolean);
const templated = `${r.title} recipe: ${nIng} ingredients${facts.length ? ', ' + facts.join(', ') : ''}. Step-by-step method and the original reel, from Ella's kitchen in Gurgaon.`;
const clean = (s: string) => s.replace(/\s+/g, ' ').trim();
const description = (r.intro ? clean(r.intro) + (clean(r.intro).length < 90 && facts.length ? ` ${facts.join(', ')}.` : '') : templated).slice(0, 158);

/* ---------- images: hero + the three ratios Google asks for + OG ---------- */
const src = photoFor(r.slug);
const abs = (p: string) => new URL(p, SITE.url).toString();
const shots = src
  ? await Promise.all([
      getImage({ src, width: 1200, height: 1200, fit: 'cover', position: 'center', format: 'jpeg', quality: 80 }),
      getImage({ src, width: 1200, height: 900, fit: 'cover', position: 'center', format: 'jpeg', quality: 80 }),
      getImage({ src, width: 1200, height: 675, fit: 'cover', position: 'center', format: 'jpeg', quality: 80 }),
      getImage({ src, width: 1200, height: 630, fit: 'cover', position: 'center', format: 'jpeg', quality: 80 }),
    ])
  : null;
const schemaImages = shots ? shots.slice(0, 3).map((s) => abs(s.src)) : undefined;
const ogImage = shots ? abs(shots[3].src) : undefined;

/* ---------- structured data ---------- */
const isoTime = r.time_minutes ? `PT${r.time_minutes}M` : undefined;
const pageUrl = `${SITE.url}/recipes/${r.slug}`;
const recipeLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  '@id': `${pageUrl}#recipe`,
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  name: r.title,
  ...(schemaImages ? { image: schemaImages } : {}),
  author: { '@type': 'Person', name: SITE.author, url: `${SITE.url}/about`, sameAs: [SITE.instagram] },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  datePublished: r.posted,
  description,
  ...(isoTime ? { totalTime: isoTime } : {}),
  ...(r.serves ? { recipeYield: `${r.serves} servings` } : {}),
  ...(inCategories.length ? { recipeCategory: inCategories.map((c) => c.name).slice(0, 3).join(', ') } : {}),
  recipeCuisine: r.tags.includes('pasta') || r.tags.includes('noodles') ? 'Fusion' : 'Indian',
  keywords: [...new Set([...r.keywords, ...r.tags.map((t) => t.replace(/-/g, ' '))])].join(', '),
  recipeIngredient: r.ingredients.flatMap((g) => g.items),
  recipeInstructions: r.method.map((step, i) => ({ '@type': 'HowToStep', position: i + 1, text: step, url: `${pageUrl}#step-${i + 1}` })),
  ...(r.macros.kcal || r.macros.protein
    ? {
        nutrition: {
          '@type': 'NutritionInformation',
          servingSize: '1 serving',
          ...(r.macros.kcal ? { calories: `${r.macros.kcal} calories` } : {}),
          ...(r.macros.protein ? { proteinContent: `${r.macros.protein} g` } : {}),
          ...(r.macros.carbs ? { carbohydrateContent: `${r.macros.carbs} g` } : {}),
          ...(r.macros.fat ? { fatContent: `${r.macros.fat} g` } : {}),
        },
      }
    : {}),
  ...(reelId && schemaImages
    ? {
        video: {
          '@type': 'VideoObject',
          name: `${r.title} — the reel`,
          description,
          thumbnailUrl: schemaImages,
          uploadDate: r.posted,
          ...(reel?.dur ? { duration: `PT${Math.round(reel.dur)}S` } : {}),
          embedUrl: `https://www.instagram.com/reel/${reelId}/embed/`,
          contentUrl: r.source_url,
          ...(reel?.views ? { interactionStatistic: { '@type': 'InteractionCounter', interactionType: { '@type': 'WatchAction' }, userInteractionCount: reel.views } } : {}),
        },
      }
    : {}),
  sameAs: r.source_url,
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Recipes', item: `${SITE.url}/recipes` },
    ...(inCategories[0] ? [{ '@type': 'ListItem', position: 3, name: inCategories[0].name, item: `${SITE.url}/categories/${inCategories[0].id}` }] : []),
    { '@type': 'ListItem', position: inCategories[0] ? 4 : 3, name: r.title, item: pageUrl },
  ],
};
const posted = new Date(r.posted).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={seoTitle} description={description} ogType="article" jsonLd={[recipeLd, crumbsLd]} image={ogImage} imageAlt={r.title}>
  <article class="recipe">
    <div class="wrap">

      <nav class="crumbs no-print" aria-label="Breadcrumb">
        <a href="/recipes">Recipes</a>
        {inCategories[0] && <><span aria-hidden="true">/</span><a href={`/categories/${inCategories[0].id}`}>{inCategories[0].name}</a></>}
      </nav>

      <header class="head">
        <div class="head-txt">
          {r.series && <p class="kick">{r.series}{r.episode ? ` · No. ${r.episode}` : ''}</p>}
          <h1>{r.title}</h1>
          {r.intro && <p class="lede">{r.intro}</p>}
          <dl class="facts">
            {r.time_minutes && <div><dt>Time</dt><dd>{r.time_minutes} min</dd></div>}
            {r.serves && <div><dt>Serves</dt><dd>{r.serves}</dd></div>}
            {r.cost_for_two && <div><dt>Cost</dt><dd>₹{r.cost_for_two} <small>for two</small></dd></div>}
            {r.macros.kcal && <div><dt>Calories</dt><dd>{r.macros.kcal} <small>kcal</small></dd></div>}
            {r.macros.protein && <div><dt>Protein</dt><dd>{r.macros.protein}g</dd></div>}
          </dl>
          <div class="actions no-print">
            <a href="#ingredients" class="btn">Jump to the recipe
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M6 13l6 6 6-6"></path></svg></a>
            <button type="button" class="btn-ghost" onclick="window.print()">Print</button>
            <a href={r.source_url} class="link-ul" rel="noopener">Open on Instagram</a>
          </div>
        </div>
        <div class="hero-img" id="hero">
          <Photo recipe={r} aspect="4/5" width={480} sizes="(max-width: 600px) 100vw, 480px" priority />
          {reelId && (
            <button type="button" class="play no-print" id="playReel" data-permalink={`https://www.instagram.com/reel/${reelId}/`} aria-label="Play the reel">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg> Watch the reel
            </button>
          )}
        </div>
      </header>

      <div class="body">
        <aside class="ing" id="ingredients">
          <h2>Ingredients</h2>
          {r.ingredients.map((g) => (
            <div class="group">
              {g.name && <h3>{g.name}</h3>}
              <ul>
                {g.items.map((it) => (
                  <li><label><input type="checkbox" class="no-print" /><span>{it}</span></label></li>
                ))}
              </ul>
            </div>
          ))}
          {macros.length > 0 && (
            <div class="macros">
              <h3>Per serving</h3>
              <ul>{macros.map((m) => <li>{m}</li>)}</ul>
            </div>
          )}
        </aside>

        <div class="method">
          <h2>Method</h2>
          <ol>{r.method.map((step, i) => <li id={`step-${i + 1}`}>{step}</li>)}</ol>
          {r.tips.length > 0 && (
            <div class="tips">
              <h3>Ella's notes</h3>
              <ul>{r.tips.map((tip) => <li>{tip}</li>)}</ul>
            </div>
          )}
          <p class="posted">First posted on Instagram, {posted}. <a href={r.source_url} rel="noopener">See the original reel →</a></p>
          {(inCollections.length > 0 || inCategories.length > 0) && (
            <div class="chips no-print">
              {inCollections.map((c) => <a class="chip" href={`/collections/${c.id}`}>{c.short}</a>)}
              {inCategories.map((c) => <a class="chip" href={`/categories/${c.id}`}>{c.name}</a>)}
              {sid && <a class="chip" href={`/recipes?q=${encodeURIComponent(r.series!)}`}>{r.series}</a>}
            </div>
          )}
        </div>
      </div>

    </div>
  </article>

  {related.length > 0 && (
    <section class="sec no-print">
      <div class="wrap">
        <div class="sec-head"><div><h2>You might also like</h2></div><a href="/recipes" class="link-arrow">All recipes →</a></div>
        <div class="row">{related.map((o) => <RecipeCard recipe={o} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .recipe .wrap { padding-top: 24px; padding-bottom: 88px; }
  .crumbs { display: flex; gap: 10px; font-size: 13px; color: var(--muted); padding-bottom: 24px; }
  .crumbs a { color: var(--muted); }
  .head { display: flex; flex-wrap: wrap; gap: 32px 56px; align-items: flex-start; padding-bottom: 48px; border-bottom: 1px solid var(--ink); margin-bottom: 48px; }
  .head-txt { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .head h1 { font-weight: 500; font-size: clamp(36px, 5vw, 60px); line-height: 1.05; letter-spacing: -0.015em; }
  .lede { font-size: 18px; line-height: 1.6; color: var(--muted); max-width: 56ch; }
  .facts { display: flex; flex-wrap: wrap; gap: 12px 32px; margin: 4px 0 0; }
  .facts div { display: flex; flex-direction: column; gap: 2px; }
  .facts dt { font-weight: 600; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 0; font-family: var(--hand); font-weight: 700; font-size: 32px; line-height: 1; color: var(--berry); }
  .facts dd small { font-family: var(--serif); font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-img { flex: 1 1 360px; min-width: 0; max-width: 480px; position: relative; }
  .hero-img :global(.photo) { aspect-ratio: 4 / 5; }
  .play { position: absolute; left: 16px; bottom: 16px; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px 0 12px; border: 0; border-radius: 999px; background: var(--paper); color: var(--ink); font: inherit; font-weight: 600; font-size: 14px; cursor: pointer; box-shadow: 0 2px 12px rgba(31,28,61,.25); }
  .play:hover { background: var(--butter); }
  /* the reel player: Instagram's embed sizes its own iframe to the 9:16 reel; we only give it the column */
  .hero-img.playing { max-width: 480px; }
  .hero-img :global(.instagram-media) { margin: 0 !important; width: 100% !important; min-width: 0 !important; max-width: 480px !important; border-radius: 0 !important; box-shadow: none !important; }
  .hero-img :global(iframe.instagram-media) { border: 0 !important; }
  .reel-loading { aspect-ratio: 9 / 16; display: flex; align-items: center; justify-content: center; background: var(--ink); color: var(--cream); font-size: 14px; }
  @media (max-width: 600px) { .hero-img { max-width: none; order: -1; } .hero-img :global(.photo) { aspect-ratio: 4 / 3; } .head { padding-bottom: 32px; margin-bottom: 32px; } }

  .body { display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-start; }
  .ing { flex: 1 1 300px; max-width: 400px; min-width: 0; background: var(--paper); border: 1px solid var(--line); padding: 28px; position: sticky; top: 16px; display: flex; flex-direction: column; gap: 20px; }
  @media (max-width: 800px) { .ing { position: static; max-width: none; } }
  .ing h2, .method h2 { font-family: var(--hand); font-weight: 700; font-size: 44px; line-height: .95; }
  .ing h3, .macros h3, .tips h3 { font-weight: 600; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--berry); margin-bottom: 8px; }
  .ing ul { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .ing li label { display: flex; gap: 12px; align-items: flex-start; padding: 9px 0; border-bottom: 1px dotted var(--line); cursor: pointer; font-size: 16px; line-height: 1.45; }
  .ing li:last-child label { border-bottom: 0; }
  .ing input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--berry); flex: 0 0 auto; }
  .ing input:checked + span { color: var(--muted); text-decoration: line-through; }
  .macros { border-top: 1px solid var(--ink); padding-top: 16px; }
  .macros ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 15px; }
  .method { flex: 2 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .method ol { padding-left: 0; list-style: none; counter-reset: step; display: flex; flex-direction: column; gap: 20px; }
  .method ol li { counter-increment: step; display: flex; gap: 18px; font-size: 17px; line-height: 1.6; max-width: 66ch; }
  .method ol li::before { content: counter(step); font-family: var(--hand); font-weight: 700; font-size: 34px; line-height: 1; color: var(--berry); min-width: 28px; flex: 0 0 auto; margin-top: 2px; }
  .tips { background: var(--honey); padding: 22px 24px; max-width: 66ch; }
  .tips ul { padding-left: 18px; display: flex; flex-direction: column; gap: 8px; font-size: 16px; }
  .posted { font-size: 14px; color: var(--muted); }
  .posted a { color: var(--berry); }
  @media print { .ing { border: 0; padding: 0; } .ing li label { padding: 4px 0; } .hero-img { display: none; } }
</style>

<script>
  // "Watch the reel": swap the photo for Instagram's official embed, which renders the reel at its
  // native 9:16 and resizes its own iframe. Loaded only on tap, so the page stays light otherwise.
  const btn = document.getElementById('playReel') as HTMLButtonElement | null;
  btn?.addEventListener('click', () => {
    const host = document.getElementById('hero')!;
    host.classList.add('playing');
    host.innerHTML = `<div class="reel-loading">Loading the reel…</div><blockquote class="instagram-media" data-instgrm-permalink="${btn.dataset.permalink}" data-instgrm-version="14"></blockquote>`;
    const ready = () => {
      (window as any).instgrm?.Embeds?.process();
      // once Instagram has swapped the blockquote for its iframe, drop the placeholder
      const t = setInterval(() => { if (host.querySelector('iframe')) { host.querySelector('.reel-loading')?.remove(); clearInterval(t); } }, 200);
      setTimeout(() => clearInterval(t), 15000);
    };
    if ((window as any).instgrm) ready();
    else { const s = document.createElement('script'); s.src = 'https://www.instagram.com/embed.js'; s.async = true; s.onload = ready; document.body.appendChild(s); }
  });
</script>
