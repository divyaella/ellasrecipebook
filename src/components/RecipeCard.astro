---
import type { Recipe } from '../data/site';
import { meta, tone, fmtCost } from '../data/site';

interface Props {
  recipe: Recipe;
  label?: string;          // small uppercase tag above the title
  badge?: 'time' | 'cost' | 'protein' | 'kcal' | 'reel' | null;
  aspect?: '4/3' | '9/16' | '1/1';
}
const { recipe: r, label, badge = null, aspect = '4/3' } = Astro.props;
const t = tone(r);
const tagText = label ?? (r.series ?? (r.tags.includes('breakfast') ? 'breakfast' : r.tags.includes('dessert') ? 'dessert' : r.tags.includes('salad') ? 'salad' : 'mains'));
---
<a href={`/recipes/${r.slug}`} class="card">
  <div class={`ph img t-${t} ${t === 'berry' ? 'ph-dark' : ''}`} style={`aspect-ratio:${aspect}`}>
    {r.image ? <img src={r.image} alt="" loading="lazy" /> : <span class="cap">photo</span>}
    {badge === 'time' && r.time_minutes && <span class="time badge-tl">{r.time_minutes}<small>min</small></span>}
    {badge === 'cost' && r.cost_for_two && <span class="time badge-tl">₹{r.cost_for_two}<small>for two</small></span>}
    {badge === 'protein' && r.macros.protein && <span class="time badge-tl">{r.macros.protein}g<small>protein</small></span>}
    {badge === 'kcal' && r.macros.kcal && <span class="time badge-tl">{r.macros.kcal}<small>kcal</small></span>}
    {badge === 'reel' && <span class="pill badge-tl">Reel</span>}
  </div>
  <span class="tag">{tagText}</span>
  <span class="t">{r.title}</span>
  {(meta(r) || fmtCost(r)) && <span class="meta">{[meta(r), fmtCost(r)].filter(Boolean).join(' · ')}</span>}
</a>
